              "id": "1ca604e1-24c4-4a3b-a73e-6dc099c01e7b",
              "leftValue": "={{ $json.isValid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        720,
        0
      ],
      "id": "7106e36b-fe4b-404b-bd15-a577a5c5853a",
      "name": "If1"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn {\n  json: {\n    ...item,\n    aiData: {\n      headline: `[Cập nhật] Chiến dịch: ${item.cleanTopic}`,\n      body: `Nội dung đang được ban truyền thông biên tập chi tiết cho chiến dịch ${item.cleanTopic}.`,\n      cta: 'Theo dõi để nhận thông tin mới nhất!',\n      hashtags: ['#PRUpdate', '#Campaign2026'],\n      image_prompt: 'Professional corporate banner marketing modern minimal high resolution'\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        80
      ],
      "id": "51e1853d-4aec-4a79-955e-a017a0290e4c",
      "name": "Code in JavaScript (Fallback)"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst ai = data.aiData;\n\nconst promptEncoded = encodeURIComponent(ai.image_prompt || 'modern advertising banner');\nconst bannerUrl = `https://image.pollinations.ai/prompt/${promptEncoded}?width=1200&height=630&nologo=true`;\nconst fullContent = `${ai.headline}\\n\\n${ai.body}\\n\\n👉 ${ai.cta}\\n\\n${(ai.hashtags || []).join(' ')}`;\n\nreturn {\n  json: {\n    postId: data.postId,\n    topic: data.cleanTopic,\n    headline: ai.headline,\n    fullContent: fullContent,\n    bannerUrl: bannerUrl,\n    imagePrompt: ai.image_prompt,\n    platform: data.platform\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
