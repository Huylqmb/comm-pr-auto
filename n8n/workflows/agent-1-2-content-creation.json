    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-goog-api-key",
              "value": "YOUR_GEMINI_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"Bạn là chuyên gia PR & Social Media Marketing. Viết bài cho chủ đề: {{ $json.cleanTopic }}, Đối tượng: {{ $json.targetAudience }}, Tông giọng: {{ $json.tone }}, Nền tảng: {{ $json.platform }}. Trả về ĐÚNG cấu trúc JSON sau (không dùng markdown khác):\\n{\\n  \\\"headline\\\": \\\"Tiêu đề bài viết ngắn gọn\\\",\\n  \\\"body\\\": \\\"Nội dung chính\\\",\\n  \\\"cta\\\": \\\"Kêu gọi hành động\\\",\\n  \\\"hashtags\\\": [\\\"#tag1\\\", \\\"#tag2\\\"],\\n  \\\"image_prompt\\\": \\\"1 câu prompt tiếng Anh mô tả ảnh quảng bá phù hợp\\\"\\n}\"\n    }]\n  }],\n  \"generationConfig\": {\n    \"response_mime_type\": \"application/json\"\n  }\n}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        272,
        0
      ],
      "id": "95613b88-5c1e-4743-a151-e5cec51e7c29",
      "name": "HTTP Request",
      "retryOnFail": true,
      "waitBetweenTries": 2000,
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\nlet parsed = {};\ntry {\n  parsed = JSON.parse(rawText.replace(/```json|```/g, '').trim());\n} catch (e) {\n  parsed = { error: true, raw: rawText };\n}\n\nconst meta = $('Edit Fields').first().json;\n\nreturn {\n  json: {\n    ...meta,\n    aiData: parsed,\n    isValid: Boolean(parsed.headline && parsed.body)\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        0
      ],
      "id": "857e6e0c-df6a-4d15-b5d1-4eb7a90cabd8",
      "name": "Parse & Clean JSON"
